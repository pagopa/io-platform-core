{
  "name": "@pagopa/hexagonal-core",
  "version": "0.0.0",
  "description": "Framework-agnostic hexagonal building blocks (shared domain + adapter primitives) for the IO platform ecosystem.",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./errors": {
      "import": {
        "types": "./dist/errors.d.ts",
        "default": "./dist/errors.js"
      },
      "require": {
        "types": "./dist/errors.d.cts",
        "default": "./dist/errors.cjs"
      }
    },
    "./value-objects": {
      "import": {
        "types": "./dist/value-objects.d.ts",
        "default": "./dist/value-objects.js"
      },
      "require": {
        "types": "./dist/value-objects.d.cts",
        "default": "./dist/value-objects.cjs"
      }
    },
    "./ports": {
      "import": {
        "types": "./dist/ports.d.ts",
        "default": "./dist/ports.js"
      },
      "require": {
        "types": "./dist/ports.d.cts",
        "default": "./dist/ports.cjs"
      }
    },
    "./adapters": {
      "import": {
        "types": "./dist/adapters.d.ts",
        "default": "./dist/adapters.js"
      },
      "require": {
        "types": "./dist/adapters.d.cts",
        "default": "./dist/adapters.cjs"
      }
    }
  },
  "scripts": {
    "clean": "shx rm -rf dist",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm lint:check --fix",
    "lint:check": "eslint . --cache",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "io",
    "pagopa",
    "hexagonal",
    "ports-and-adapters",
    "domain",
    "zod",
    "neverthrow"
  ],
  "author": "PagoPA Platform Team",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@standard-schema/spec": "catalog:",
    "neverthrow": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@pagopa/io-platform-typescript-config-node": "workspace:^",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "shx": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
