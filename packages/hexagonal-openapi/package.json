{
  "name": "@pagopa/hexagonal-openapi",
  "version": "0.1.2",
  "private": false,
  "description": "Code-first OpenAPI toolkit for the IO platform: framework-agnostic route contracts, a route registry and an OpenAPI 3.1 generator built on Zod.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pagopa/io-platform-core.git"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "clean": "shx rm -rf dist",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm lint:check --fix",
    "lint:check": "eslint . --cache",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "io",
    "pagopa",
    "openapi",
    "code-first",
    "zod",
    "hexagonal"
  ],
  "author": "PagoPA Platform Team",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "catalog:",
    "@pagopa/hexagonal-core": "workspace:^",
    "yaml": "catalog:"
  },
  "peerDependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@pagopa/io-platform-typescript-config-node": "workspace:^",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "shx": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
